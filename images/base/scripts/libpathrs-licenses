# this script saves license notices for libpathrs and the rust crates
# statically linked into it, similar to go-licenses save for go code
# it must be run from the libpathrs git checkout after building
#
# usage: libpathrs-licenses <save path>
#
# libpathrs is MPL-2.0 OR LGPL-3.0-or-later, we distribute it under the MPL-2.0
# which requires informing recipients where to obtain the source code

set -o errexit -o nounset -o pipefail

save_path="$1"

# libpathrs itself
libpathrs_dir="${save_path}/github.com/cyphar/libpathrs"
mkdir -p "${libpathrs_dir}"
cp LICENSE.* "${libpathrs_dir}/"
version="$(git describe --tags --exact-match)"
cat >"${libpathrs_dir}/SOURCE" <<EOF
runc in this image is statically linked against libpathrs ${version}, which is
distributed under the terms of the Mozilla Public License, v. 2.0, see
LICENSE.MPL-2.0 in this directory.

The unmodified source code is available from:
https://github.com/cyphar/libpathrs/tree/${version}
commit: $(git rev-parse HEAD)
EOF

# rust crates linked into libpathrs for this target, these should already be
# in the cargo registry from building libpathrs
registry="${CARGO_HOME:-${HOME}/.cargo}/registry/src"
cargo tree --locked --offline --features=capi --target="$(target-rust)" \
    --edges=normal,no-proc-macro --prefix=none --format='{p}' \
  | awk '$1 != "pathrs" { sub(/^v/, "", $2); print $1, $2 }' | sort -u \
  | while read -r name crate_version; do
    crate_src=("${registry}"/*/"${name}-${crate_version}")
    if [ ! -d "${crate_src[0]}" ]; then
      echo "missing source for crate ${name} ${crate_version}" >&2
      exit 1
    fi
    crate_dir="${save_path}/crates.io/crates/${name}-${crate_version}"
    mkdir -p "${crate_dir}"
    find "${crate_src[0]}" -maxdepth 1 -type f \( -iname 'LICEN[CS]E*' \
      -o -iname 'COPYING*' -o -iname 'NOTICE*' -o -iname 'UNLICENSE*' \) \
      -exec cp {} "${crate_dir}/" \;
    if [ -z "$(ls -A "${crate_dir}")" ]; then
      echo "no license files found for crate ${name} ${crate_version}" >&2
      exit 1
    fi
  done
